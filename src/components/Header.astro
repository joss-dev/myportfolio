---
const {
  brand = "Joss.dev",
  textColor = "text-white",
  hoverColor = "hover:text-cyan-400",
  background = "bg-gray-900"
} = Astro.props;
---
<script>
  const initMenu = () => {
    const btn = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const links = document.querySelectorAll('#mobile-menu a');

    if (!btn || !menu) return;

    let open = false;

    const toggleMenu = () => {
      open = !open;
      menu.classList.toggle('hidden', !open);
      menu.classList.toggle('flex', open);
    };

    btn.addEventListener('click', toggleMenu);

    links.forEach(link => {
      link.addEventListener('click', () => {
        open = false;
        menu.classList.add('hidden');
        menu.classList.remove('flex');
      });
    });
  };

  // Ejecución limpia en Astro client script
  initMenu();
  document.addEventListener('astro:page-load', initMenu);
</script>

<nav class={`${background} ${textColor} p-4 fixed w-full top-0 left-0 z-50 shadow-sm`}>
  <div class="container mx-auto flex justify-between items-center">
    <a href="/" class="text-2xl font-bold">{brand}</a>

    <!-- Botón hamburguesa -->
    <button id="menu-toggle" class="md:hidden focus:outline-none p-2" aria-label="Abrir menú de navegación">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2"
           viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>

    <!-- Menú de navegación -->
    <ul id="mobile-menu"
      class={`hidden md:flex md:space-x-6 text-sm transition-all duration-300 ease-in-out absolute md:static top-full left-0 w-full md:w-auto ${background} md:bg-transparent flex-col md:flex-row shadow-md md:shadow-none`}
    >
      <li class="border-b border-gray-800 md:border-0 px-4 py-2 md:py-0">
        <a href="#about" class={`block transition ${hoverColor}`}>Sobre mí</a>
      </li>
      <li class="border-b border-gray-800 md:border-0 px-4 py-2 md:py-0">
        <a href="#projects" class={`block transition ${hoverColor}`}>Proyectos</a>
      </li>
      <li class="border-b border-gray-800 md:border-0 px-4 py-2 md:py-0">
        <a href="#skills" class={`block transition ${hoverColor}`}>Skills</a>
      </li>
      <li class="border-b border-gray-800 md:border-0 px-4 py-2 md:py-0">
        <a href="#experience" class={`block transition ${hoverColor}`}>Experiencia</a>
      </li>
      <li class="border-b border-gray-800 md:border-0 px-4 py-2 md:py-0">
        <a href="#education" class={`block transition ${hoverColor}`}>Educación</a>
      </li>
      <li class="px-4 py-2 md:py-0">
        <a href="#contact" class={`block transition ${hoverColor}`}>Contacto</a>
      </li>
    </ul>
  </div>
</nav>
