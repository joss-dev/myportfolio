---
import skills from "../data/skills.json";
---

<section id="skills" class="py-20 text-white text-center scroll-mt-24">
  <h2 class="text-3xl font-extrabold mb-10 text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500">
    Habilidades Técnicas
  </h2>

  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-8 max-w-5xl mx-auto px-4">
    {skills.map(({ name, logo }) => (
      <div class="flex flex-col items-center p-4 rounded-xl bg-white/5 hover:bg-white/10 transition-all duration-300 transform hover:scale-105 hover:shadow-lg hover:shadow-cyan-500/30">
        <img
          src={logo}
          alt={`Logo de ${name}`}
          loading="lazy"
          decoding="async"
          width="48"
          height="48"
          class="w-12 h-12 object-contain mb-2"
        />
        <span class="text-sm mt-1">{name}</span>
      </div>
    ))}
  </div>
</section>
