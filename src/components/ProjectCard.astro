---
interface Props {
  title: string;
  description: string;
  images?: string[];
  repo: string;
  demo: string;
  details: string;
  tech?: string[];
}

const {
  title,
  description,
  images = [],
  repo,
  demo,
  details,
  tech = [],
} = Astro.props;

const firstImage = images.length > 0 ? images[0] : "";
---

<div
  data-images={JSON.stringify(images)}
  data-details={details}
  class="project-card flex flex-col justify-between rounded-xl p-4 shadow-md bg-gray-800 text-white space-y-4 h-full relative"
>
  <!-- Carrusel de imágenes -->
  <div class="relative overflow-hidden rounded-lg">
    <img
      src={firstImage}
      alt={`Vista previa de ${title}`}
      loading="lazy"
      decoding="async"
      width="400"
      height="192"
      class="card-main-img w-full h-48 object-cover rounded-md cursor-pointer transition duration-300 hover:opacity-80"
    />

    {images.length > 1 && (
      <>
        <button
          type="button"
          aria-label="Imagen anterior"
          class="prev-btn absolute left-2 top-1/2 -translate-y-1/2 bg-black/70 text-2xl p-2 rounded-full text-white hover:bg-gray-700 transition"
        >
          ‹
        </button>
        <button
          type="button"
          aria-label="Imagen siguiente"
          class="next-btn absolute right-2 top-1/2 -translate-y-1/2 bg-black/70 p-2 text-2xl rounded-full text-white hover:bg-gray-700 transition"
        >
          ›
        </button>
      </>
    )}
  </div>

  <!-- Título y descripción -->
  <div>
    <h3 class="text-xl font-bold">{title}</h3>
    <p class="text-gray-400 mt-2">{description}</p>
  </div>

  <!-- Tecnologías usadas -->
  <div class="flex flex-wrap gap-2 text-sm mt-2">
    {
      tech.map((lang) => (
        <span class="bg-gray-700 px-2 py-1 rounded text-cyan-400 font-medium">
          {lang}
        </span>
      ))
    }
  </div>

  <!-- Botones de acción -->
  <div class="mt-4">
    <div class="flex justify-around items-center text-xl">
      {repo && (
        <a
          href={repo}
          target="_blank"
          rel="noopener noreferrer"
          title="Código fuente"
          aria-label="Ver código fuente en GitHub"
          class="hover:text-cyan-400 transition"
        >
          <i class="fab fa-github"></i>
        </a>
      )}
      {demo && (
        <a
          href={demo}
          target="_blank"
          rel="noopener noreferrer"
          title="Ver demo"
          aria-label="Ver demo en vivo"
          class="hover:text-cyan-400 transition"
        >
          <i class="fas fa-external-link-alt"></i>
        </a>
      )}
      {details && (
        <button
          type="button"
          class="ver-mas-btn hover:text-cyan-400 text-base font-semibold transition"
        >
          Ver más
        </button>
      )}
    </div>
  </div>

  <!-- Modal de imagen ampliada -->
  <div class="image-modal hidden fixed inset-0 bg-black/80 flex items-center justify-center z-50 p-4">
    <div class="relative flex items-center justify-center w-full h-full max-w-5xl">
      <button
        type="button"
        aria-label="Cerrar vista ampliada"
        class="close-img-modal absolute top-4 right-4 text-white text-4xl hover:text-red-500 font-bold z-20"
      >
        &times;
      </button>

      {images.length > 1 && (
        <button
          type="button"
          aria-label="Imagen anterior"
          class="modal-prev-btn absolute left-4 bg-black/60 p-3 rounded-full text-white text-3xl z-20 hover:bg-gray-700"
        >
          ‹
        </button>
      )}

      <img
        src={firstImage}
        alt={`Vista ampliada de ${title}`}
        class="modal-img max-w-[90%] max-h-[85vh] rounded-lg shadow-2xl object-contain"
      />

      {images.length > 1 && (
        <button
          type="button"
          aria-label="Imagen siguiente"
          class="modal-next-btn absolute right-4 bg-black/60 p-3 rounded-full text-white text-3xl z-20 hover:bg-gray-700"
        >
          ›
        </button>
      )}
    </div>
  </div>

  <!-- Modal de texto "Ver más" -->
  <div class="text-modal hidden fixed inset-0 bg-black/70 flex items-center justify-center z-50 p-4">
    <div class="bg-gray-900 text-gray-100 rounded-xl shadow-2xl max-w-2xl w-full p-6 relative border border-gray-700">
      <h2 class="text-xl font-bold mb-4 text-cyan-400">Detalles del proyecto</h2>
      <p class="text-gray-300 whitespace-pre-line leading-relaxed">{details}</p>
      <button
        type="button"
        aria-label="Cerrar detalles"
        class="close-text-modal absolute top-4 right-4 font-bold text-gray-400 hover:text-white text-3xl"
      >
        &times;
      </button>
    </div>
  </div>
</div>

<script>
  const initProjectCards = () => {
    const cards = document.querySelectorAll('.project-card');

    cards.forEach((card) => {
      const imagesAttr = card.getAttribute('data-images');
      const images: string[] = imagesAttr ? JSON.parse(imagesAttr) : [];
      let currentIndex = 0;

      const mainImg = card.querySelector('.card-main-img') as HTMLImageElement;
      const prevBtn = card.querySelector('.prev-btn');
      const nextBtn = card.querySelector('.next-btn');

      const imgModal = card.querySelector('.image-modal') as HTMLElement;
      const modalImg = card.querySelector('.modal-img') as HTMLImageElement;
      const closeImgModal = card.querySelector('.close-img-modal');
      const modalPrevBtn = card.querySelector('.modal-prev-btn');
      const modalNextBtn = card.querySelector('.modal-next-btn');

      const textModal = card.querySelector('.text-modal') as HTMLElement;
      const verMasBtn = card.querySelector('.ver-mas-btn');
      const closeTextModal = card.querySelector('.close-text-modal');

      const updateImages = () => {
        if (images.length === 0) return;
        if (mainImg) mainImg.src = images[currentIndex];
        if (modalImg) modalImg.src = images[currentIndex];
      };

      prevBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        currentIndex = (currentIndex - 1 + images.length) % images.length;
        updateImages();
      });

      nextBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        currentIndex = (currentIndex + 1) % images.length;
        updateImages();
      });

      mainImg?.addEventListener('click', () => {
        if (imgModal) {
          imgModal.classList.remove('hidden');
          document.body.classList.add('overflow-hidden');
        }
      });

      closeImgModal?.addEventListener('click', () => {
        if (imgModal) {
          imgModal.classList.add('hidden');
          document.body.classList.remove('overflow-hidden');
        }
      });

      modalPrevBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        currentIndex = (currentIndex - 1 + images.length) % images.length;
        updateImages();
      });

      modalNextBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        currentIndex = (currentIndex + 1) % images.length;
        updateImages();
      });

      imgModal?.addEventListener('click', (e) => {
        if (e.target === imgModal) {
          imgModal.classList.add('hidden');
          document.body.classList.remove('overflow-hidden');
        }
      });

      verMasBtn?.addEventListener('click', () => {
        if (textModal) {
          textModal.classList.remove('hidden');
          document.body.classList.add('overflow-hidden');
        }
      });

      closeTextModal?.addEventListener('click', () => {
        if (textModal) {
          textModal.classList.add('hidden');
          document.body.classList.remove('overflow-hidden');
        }
      });

      textModal?.addEventListener('click', (e) => {
        if (e.target === textModal) {
          textModal.classList.add('hidden');
          document.body.classList.remove('overflow-hidden');
        }
      });
    });
  };

  initProjectCards();
  document.addEventListener('astro:page-load', initProjectCards);
</script>
